# Copy to deploy/.env on a fresh VPS:
#   cp deploy/.env.standalone.example deploy/.env

# --- Public access ---
MYFREELANCE_HOST_PORT=8082

# --- SQL Server (standalone container) ---
# Must meet SQL complexity rules: upper, lower, digit, symbol, 8+ chars.
MSSQL_SA_PASSWORD=ChangeMe_Strong_Sql_123!

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
ASPNETCORE_ALLOWED_HOSTS=*

Auth__CookieSecurePolicy=SameAsRequest
App__UseHttpsRedirection=false

# Overridden by docker-compose.standalone.yml (uses sqlserver hostname).
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=MyFreelance;User Id=sa;Password=ChangeMe_Strong_Sql_123!;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# --- Auth (change before production) ---
Jwt__Key=Change-This-To-A-Random-32-Character-Key!!

# --- SMS (optional) ---
Sms__Provider=Twilio
Sms__Twilio__AccountSid=
Sms__Twilio__AuthToken=
Sms__Twilio__FromNumber="whatsapp:+14155238886"
Sms__Twilio__Channel=WhatsApp

# --- Storage / logging ---
FileStorage__Path=/app/uploads
DatabaseLogging__Enabled=true
DatabaseLogging__MinimumLevel=Error
