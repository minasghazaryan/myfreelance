# Copy to deploy/.env and fill in values:
#   cp deploy/.env.example deploy/.env

# --- Docker network (from your VPS: docker network ls) ---
# KinoHub containers (kino-nginx-1, kino-app-1, kino-sqlserver-1) use this network.
KINOHUB_DOCKER_NETWORK=kino_default

# --- Public access (no domain yet) ---
# App URL: http://157.173.102.52:8082
# Port 80 is used by KinoHub nginx; 1433 by SQL Server — do not reuse those.
MYFREELANCE_HOST_PORT=8082

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
ASPNETCORE_ALLOWED_HOSTS=*

# HTTP via IP (no HTTPS yet) — required for login cookies to work.
# When you add HTTPS via nginx, set:
#   Auth__CookieSecurePolicy=Always
#   App__UseHttpsRedirection=true
Auth__CookieSecurePolicy=SameAsRequest
App__UseHttpsRedirection=false

# --- Database ---
# sqlserver = Docker DNS name on kino_default (same as KinoHub app uses).
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=MyFreelance;User Id=sa;Password=KinoHub_Sql_Secret_123;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# Fallback via host IP if Docker DNS name does not resolve:
# ConnectionStrings__DefaultConnection=Server=157.173.102.52,1433;Database=MyFreelance;User Id=sa;Password=KinoHub_Sql_Secret_123;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# --- Auth ---
Jwt__Key=AurumWealth-Super-Secret-Key-Min-32-Chars!!
Jwt__Issuer=AurumWealth
Jwt__Audience=AurumWealth.Api

# --- SMS (optional) ---
Sms__Provider=Twilio
Sms__Twilio__AccountSid=
Sms__Twilio__AuthToken=
Sms__Twilio__FromNumber="whatsapp:+14155238886"
Sms__Twilio__Channel=WhatsApp

# --- Storage / logging ---
FileStorage__Path=/app/uploads
DatabaseLogging__Enabled=true
DatabaseLogging__MinimumLevel=Error
