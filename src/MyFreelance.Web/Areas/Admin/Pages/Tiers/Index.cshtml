@page
@model MyFreelance.Web.Areas.Admin.Pages.Tiers.IndexModel
@{ ViewData["Title"] = "Investment Tiers"; }

<div class="dashboard-layout">
    <div class="container-fluid">
        <div class="row">
            <partial name="Shared/_AdminNav" />
            <div class="col-lg-10 p-4">
                <h2 class="text-gold mb-4">Investment Tier Management</h2>
                @if (User.IsInRole(AppRoles.Admin))
                {
                <div class="aurum-card mb-4">
                    <h5 class="text-gold">Add Tier</h5>
                    <form method="post" class="row g-3 mt-2">
                        <div class="col-md-6 col-lg-2">
                            <label asp-for="Input.Name" class="form-label small text-muted-light">Name</label>
                            <input asp-for="Input.Name" class="form-control form-control-aurum" placeholder="e.g. Platinum" required />
                        </div>
                        <div class="col-md-6 col-lg-2">
                            <label asp-for="Input.ProjectedYieldPercent" class="form-label small text-muted-light">Yield %</label>
                            <input asp-for="Input.ProjectedYieldPercent" type="number" step="0.1" min="0" class="form-control form-control-aurum" placeholder="10" required />
                        </div>
                        <div class="col-md-6 col-lg-2">
                            <label asp-for="Input.MinInvestment" class="form-label small text-muted-light">Min ($)</label>
                            <input asp-for="Input.MinInvestment" type="number" step="0.01" min="0" class="form-control form-control-aurum" placeholder="100" required />
                        </div>
                        <div class="col-md-6 col-lg-2">
                            <label asp-for="Input.MaxInvestment" class="form-label small text-muted-light">Max ($)</label>
                            <input asp-for="Input.MaxInvestment" type="number" step="0.01" min="0" class="form-control form-control-aurum" placeholder="5000" required />
                        </div>
                        <div class="col-md-6 col-lg-2">
                            <label asp-for="Input.RiskLevel" class="form-label small text-muted-light">Risk</label>
                            <select asp-for="Input.RiskLevel" class="form-control form-control-aurum" asp-items="Html.GetEnumSelectList<RiskLevel>()" required></select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.Description" class="form-label small text-muted-light">Description</label>
                            <textarea asp-for="Input.Description" class="form-control form-control-aurum" rows="2" placeholder="Short tier description for investors"></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.PackageDetails" class="form-label small text-muted-light">Package Details (one line per bullet, shown in Learn more)</label>
                            <textarea asp-for="Input.PackageDetails" class="form-control form-control-aurum" rows="4" placeholder="Conservative allocation mix&#10;30-day investment cycle&#10;..."></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.InsuranceNotice" class="form-label small text-muted-light">Insurance Banner (optional)</label>
                            <input asp-for="Input.InsuranceNotice" class="form-control form-control-aurum" placeholder="Insured by the African Insurance Organisation — AIO — zero risk." />
                        </div>
                        <div class="col-12"><button type="submit" class="btn btn-aurum">Create Tier</button></div>
                    </form>
                </div>
                }
                <table class="table table-aurum">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Yield</th>
                            <th>Min</th>
                            <th>Max</th>
                            <th>Risk</th>
                            <th>Promo</th>
                            @if (User.IsInRole(AppRoles.Admin)) { <th>Order</th><th></th> }
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.Tiers.Count; i++)
                    {
                        var t = Model.Tiers[i];
                        <tr>
                            <td>@t.SortOrder</td>
                            <td>@t.Name</td>
                            <td>@t.ProjectedYieldPercent.ToString("0.##")%</td>
                            <td>$@t.MinInvestment.ToString("N0")</td>
                            <td>$@t.MaxInvestment.ToString("N0")</td>
                            <td>@(Enum.IsDefined(typeof(RiskLevel), t.RiskLevel) ? t.RiskLevel.ToString() : "Low")</td>
                            <td class="small text-muted-light">
                                @if (!string.IsNullOrWhiteSpace(t.PromoBannerText))
                                {
                                    <span>@t.PromoBannerText</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            @if (User.IsInRole(AppRoles.Admin))
                            {
                            <td>
                                <div class="d-flex gap-1">
                                    <form method="post" asp-page-handler="Move">
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <input type="hidden" name="direction" value="up" />
                                        <button type="submit" class="btn btn-sm btn-aurum-outline" @(i == 0 ? "disabled" : null) title="Move up"><i class="bi bi-arrow-up"></i></button>
                                    </form>
                                    <form method="post" asp-page-handler="Move">
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <input type="hidden" name="direction" value="down" />
                                        <button type="submit" class="btn btn-sm btn-aurum-outline" @(i == Model.Tiers.Count - 1 ? "disabled" : null) title="Move down"><i class="bi bi-arrow-down"></i></button>
                                    </form>
                                </div>
                            </td>
                            <td>
                                <form method="post" asp-page-handler="Delete">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
