@page
@model MyFreelance.Web.Areas.Admin.Pages.Bonuses.IndexModel
@{ ViewData["Title"] = "Award Bonus"; }

<div class="dashboard-layout">
    <div class="container-fluid">
        <div class="row">
            <partial name="Shared/_AdminNav" />
            <div class="col-lg-10 p-4">
                <h2 class="text-gold mb-4">Award Bonus</h2>
                <p class="text-muted-light mb-4">Credit a bonus directly to a client's available balance. The client receives a notification and it appears in their transaction history.</p>

                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage</div>
                }
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i>@Model.ErrorMessage</div>
                }

                @if (User.IsInRole(AppRoles.Admin))
                {
                    <div class="aurum-card mb-4">
                        <h5 class="text-gold">New Bonus</h5>
                        <form method="post" asp-page-handler="Award" class="row g-3 mt-2">
                            <div class="col-md-5">
                                <label asp-for="Input.UserId" class="form-label small text-muted-light">Client</label>
                                <select asp-for="Input.UserId" class="form-control form-control-aurum" required>
                                    <option value="">Select investor...</option>
                                    @foreach (var investor in Model.Investors)
                                    {
                                        <option value="@investor.Id">@investor.Name (@investor.Email)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Input.Amount" class="form-label small text-muted-light">Amount ($)</label>
                                <input asp-for="Input.Amount" type="number" step="0.01" min="0.01" class="form-control form-control-aurum" required />
                            </div>
                            <div class="col-md-12">
                                <label asp-for="Input.Description" class="form-label small text-muted-light">Description</label>
                                <input asp-for="Input.Description" class="form-control form-control-aurum" placeholder="e.g. Welcome bonus, referral reward, promotion..." required />
                                <span asp-validation-for="Input.Description" class="field-validation-error"></span>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-aurum" onclick="return confirm('Credit this bonus to the selected client?');">
                                    <i class="bi bi-gift me-1"></i>Award Bonus
                                </button>
                            </div>
                        </form>
                    </div>
                }

                <div class="aurum-card">
                    <h5 class="text-gold mb-3">Recent Bonuses</h5>
                    @if (Model.RecentBonuses.Count == 0)
                    {
                        <p class="text-muted-light mb-0">No bonuses awarded yet.</p>
                    }
                    else
                    {
                        <table class="table table-aurum mb-0">
                            <thead><tr><th>Client</th><th>Amount</th><th>Description</th><th>Date</th></tr></thead>
                            <tbody>
                            @foreach (var bonus in Model.RecentBonuses)
                            {
                                <tr>
                                    <td>@bonus.UserName<br /><span class="small text-muted-light">@bonus.UserEmail</span></td>
                                    <td class="text-success">+$@bonus.Amount.ToString("N2")</td>
                                    <td>@bonus.Description</td>
                                    <td>@bonus.CreatedAt.ToString("g")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
