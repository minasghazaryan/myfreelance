@page
@model MyFreelance.Web.Areas.Admin.Pages.Kyc.IndexModel
@{ ViewData["Title"] = "KYC Review"; }

<div class="dashboard-layout">
    <div class="container-fluid">
        <div class="row">
            <partial name="Shared/_AdminNav" />
            <div class="col-lg-10 p-4">
                <h2 class="text-gold mb-4">KYC Management</h2>
                @if (Model.Items.Count == 0)
                {
                    <div class="aurum-card">
                        <p class="text-muted-light mb-0">No pending KYC submissions.</p>
                    </div>
                }
                else
                {
                    <table class="table table-aurum">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Status</th>
                                <th>Documents</th>
                                <th>Submitted</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Status</td>
                                <td>@item.DocumentCount / 4</td>
                                <td>@item.CreatedAt.ToString("g")</td>
                                <td class="text-nowrap">
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-aurum-outline me-1">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>
                                    @if (User.IsInRole(AppRoles.Admin))
                                    {
                                        <form method="post" asp-page-handler="Approve" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Approve without opening details?');">Approve</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
