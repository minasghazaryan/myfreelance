@page
@model MyFreelance.Web.Areas.Admin.Pages.PostHog.IndexModel
@{ ViewData["Title"] = "PostHog"; }

<div class="dashboard-layout">
    <div class="container-fluid">
        <div class="row">
            <partial name="Shared/_AdminNav" />
            <div class="col-lg-10 p-4">
                <h2 class="text-gold mb-4">PostHog</h2>

                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage</div>
                }
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i>@Model.ErrorMessage</div>
                }

                <div class="aurum-card">
                    <p class="text-muted-light">
                        Paste your PostHog project API key (starts with <strong>phc_</strong>).
                        Use <code>https://us.i.posthog.com</code> or <code>https://eu.i.posthog.com</code> for the host.
                        The snippet is added to the public site, not the admin panel. Leave the API key blank to disable.
                    </p>
                    @if (User.IsInRole(AppRoles.Admin))
                    {
                        <form method="post" class="mt-3">
                            <label asp-for="ApiKey" class="form-label small text-muted-light">Project API key</label>
                            <input asp-for="ApiKey" class="form-control form-control-aurum mb-3" placeholder="phc_xxxxxxxx" autocomplete="off" />

                            <label asp-for="ApiHost" class="form-label small text-muted-light">API host</label>
                            <input asp-for="ApiHost" class="form-control form-control-aurum mb-3" placeholder="https://us.i.posthog.com" />

                            <button type="submit" class="btn btn-aurum">Save</button>
                        </form>
                    }
                    else
                    {
                        <div class="mt-3">
                            <label class="form-label small text-muted-light">Project API key</label>
                            <input asp-for="ApiKey" class="form-control form-control-aurum mb-3" readonly />
                            <label class="form-label small text-muted-light">API host</label>
                            <input asp-for="ApiHost" class="form-control form-control-aurum" readonly />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
