@page
@model MyFreelance.Web.Pages.Dashboard.InvestmentsModel
@using MyFreelance.Web
@{ ViewData["Title"] = "Investments"; }

<div class="dashboard-layout">
    <div class="container-fluid">
        <div class="row">
            <partial name="Shared/_DashboardNav" />
            <div class="col-lg-10 col-md-9 p-4">
                <h2 class="text-gold mb-4">Investments</h2>
                <div class="insurance-banner mb-4">
                    <i class="bi bi-shield-fill-check me-2"></i>All deposits are insured by the African Insurance Organisation — AIO. Your capital is fully protected — zero risk to investors.
                </div>
                @if (Model.ErrorMessage != null) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
                @if (Model.SuccessMessage != null) { <div class="alert alert-success">@Model.SuccessMessage</div> }

                <div class="row g-4 mb-4">
                    @foreach (var tier in Model.Tiers)
                    {
                        var isSelected = Model.SelectedTierId == tier.Id;
                        <div class="col-md-6 col-lg-4" id="tier-@tier.Id">
                            <div class="aurum-card tier-card h-100 @(isSelected ? "tier-card-selected" : null)">
                                @if (!string.IsNullOrWhiteSpace(tier.PromoBannerText))
                                {
                                    <div class="tier-promo-banner small mb-2"><i class="bi bi-stars me-1"></i>@tier.PromoBannerText</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(tier.ImagePath))
                                {
                                    var tierImageSrc = TierImageUrls.Resolve(tier.ImagePath);
                                    <div class="tier-photo-wrap mb-3">
                                        <img src="@tierImageSrc" alt="@tier.Name" class="tier-photo" />
                                    </div>
                                }
                                <div class="tier-insurance-badge small mb-2"><i class="bi bi-shield-check me-1"></i>@(string.IsNullOrWhiteSpace(tier.InsuranceNotice) ? "Fully insured — zero risk" : tier.InsuranceNotice)</div>
                                <h5>@tier.Name</h5>
                                <p class="tier-yield">@tier.ProjectedYieldPercent.ToString("0.##")% <small class="text-muted-light" style="font-size:0.5em">over 30 days</small></p>
                                <p class="small text-muted-light mb-0">~@((tier.ProjectedYieldPercent / 30m).ToString("0.##"))% daily to available balance</p>
                                <p class="small text-muted-light mt-2 mb-0">Invest between $@tier.MinInvestment.ToString("N0") and $@tier.MaxInvestment.ToString("N0")</p>
                                <form method="post" class="mt-3">
                                    <input type="hidden" name="TierId" value="@tier.Id" />
                                    <input type="number" name="Amount" class="form-control form-control-aurum mb-2" placeholder="Amount ($@tier.MinInvestment.ToString("N0") – $@tier.MaxInvestment.ToString("N0"))" step="0.01" min="@tier.MinInvestment" max="@tier.MaxInvestment" required @(isSelected ? "autofocus" : null) />
                                    <button type="submit" class="btn btn-aurum w-100">Invest in @tier.Name</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>

                <div class="aurum-card">
                    <h5 class="text-gold mb-3">Your Investments</h5>
                    <table class="table table-aurum">
                        <thead><tr><th>Tier</th><th>Amount</th><th>Yield</th><th>Progress</th><th>Earned</th><th>Status</th><th>Date</th></tr></thead>
                        <tbody>
                        @foreach (var inv in Model.Investments)
                        {
                            <tr>
                                <td>@inv.TierName</td>
                                <td>$@inv.Amount.ToString("N2")</td>
                                <td>@inv.ProjectedYieldPercent.ToString("0.##")%</td>
                                <td>@inv.AccrualDaysCompleted / 30 days</td>
                                <td>$@inv.AccruedAmount.ToString("N2")</td>
                                <td>@inv.Status</td>
                                <td>@inv.CreatedAt.ToString("d")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.SelectedTierId.HasValue)
    {
        <script>
            document.getElementById('tier-@Model.SelectedTierId')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        </script>
    }
}
