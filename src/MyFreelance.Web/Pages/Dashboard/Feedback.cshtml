@page
@model MyFreelance.Web.Pages.Dashboard.FeedbackModel
@{ ViewData["Title"] = "Share Feedback"; }

<div class="dashboard-layout">
    <div class="container-fluid">
        <div class="row">
            <partial name="Shared/_DashboardNav" />
            <div class="col-lg-10 col-md-9 p-4">
                <h2 class="text-gold mb-2">Share Your Experience</h2>
                <p class="text-muted-light mb-4">Tell us about your investment journey. Approved feedback may appear on our homepage.</p>

                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage</div>
                }
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i>@Model.ErrorMessage</div>
                }

                <div class="aurum-card mb-4">
                    <h5 class="text-gold">Your Feedback</h5>
                    <form method="post" class="mt-3">
                        <label asp-for="FeedbackContent" class="form-label">What has your experience been like?</label>
                        <textarea asp-for="FeedbackContent" class="form-control form-control-aurum" rows="5" placeholder="e.g. I invested and started receiving daily rewards. The dashboard makes everything clear..." required></textarea>
                        <span asp-validation-for="FeedbackContent" class="field-validation-error"></span>
                        <p class="small text-muted-light mt-2 mb-3">Minimum 10 characters. Our team reviews submissions before publishing.</p>
                        <button type="submit" class="btn btn-aurum">Submit Feedback</button>
                    </form>
                </div>

                @if (Model.MyFeedback.Count > 0)
                {
                    <div class="aurum-card">
                        <h5 class="text-gold mb-3">Your Submissions</h5>
                        @foreach (var item in Model.MyFeedback)
                        {
                            <div class="border-bottom border-secondary pb-3 mb-3">
                                <p class="mb-2">"@item.Content"</p>
                                <div class="d-flex flex-wrap gap-2 align-items-center small">
                                    <span class="text-muted-light">@item.CreatedAt.ToString("g")</span>
                                    @if (item.IsPublished)
                                    {
                                        <span class="badge bg-success">Published on homepage</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending review</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
