@page
@model MyFreelance.Web.Pages.Dashboard.NotificationsModel
@{ ViewData["Title"] = "Notifications"; }

<div class="dashboard-layout">
    <div class="container-fluid">
        <div class="row">
            <partial name="Shared/_DashboardNav" />
            <div class="col-lg-10 col-md-9 p-4">
                <h2 class="text-gold mb-4">Notifications</h2>

                @if (Model.Notifications.Count == 0)
                {
                    <div class="aurum-card">
                        <p class="text-muted-light mb-0"><i class="bi bi-bell me-2"></i>No notifications yet.</p>
                    </div>
                }
                else
                {
                    @foreach (var n in Model.Notifications)
                    {
                        <a asp-page="/Dashboard/NotificationDetails" asp-route-id="@n.Id" class="text-decoration-none d-block mb-2">
                            <div class="aurum-card notification-card @(n.IsRead ? "" : "border-gold")">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div>
                                        <strong class="text-gold">@n.Title</strong>
                                        <p class="small mb-0 text-muted-light">@n.Message</p>
                                    </div>
                                    <div class="text-end">
                                        <small class="text-muted-light d-block">@n.CreatedAt.ToString("g")</small>
                                        <small class="text-gold"><i class="bi bi-chevron-right"></i></small>
                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .notification-card {
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        a:hover .notification-card {
            transform: translateY(-1px);
            box-shadow: 0 0.5rem 1rem rgba(212, 175, 55, 0.08);
        }
    </style>
}
