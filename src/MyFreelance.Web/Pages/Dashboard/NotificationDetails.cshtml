@page "{id:guid}"
@model MyFreelance.Web.Pages.Dashboard.NotificationDetailsModel
@{ ViewData["Title"] = "Notification Details"; }

<div class="dashboard-layout">
    <div class="container-fluid">
        <div class="row">
            <partial name="Shared/_DashboardNav" />
            <div class="col-lg-10 col-md-9 p-4">
                @if (Model.Notification is null)
                {
                    <div class="aurum-card">
                        <p class="mb-3 text-muted-light">Notification not found.</p>
                        <a asp-page="/Dashboard/Notifications" class="btn btn-aurum-outline">Back to Notifications</a>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <a asp-page="/Dashboard/Notifications" class="text-gold small text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i>Back to Notifications
                            </a>
                            <h2 class="text-gold mt-2 mb-1">@Model.Notification.Title</h2>
                            <small class="text-muted-light">@Model.Notification.CreatedAt.ToString("f")</small>
                        </div>
                        @if (!Model.Notification.IsRead)
                        {
                            <span class="badge bg-warning text-dark">New</span>
                        }
                    </div>

                    <div class="aurum-card mb-4">
                        <p class="mb-0">@Model.Notification.Message</p>
                    </div>

                    @if (Model.Notification.Details.Count > 0)
                    {
                        <div class="aurum-card">
                            <h5 class="text-gold mb-3">Details</h5>
                            <div class="table-responsive">
                                <table class="table table-aurum mb-0">
                                    <tbody>
                                        @foreach (var item in Model.Notification.Details)
                                        {
                                            <tr>
                                                <th scope="row" class="text-muted-light" style="width: 35%;">@item.Label</th>
                                                <td>@item.Value</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="aurum-card">
                            <p class="text-muted-light mb-0">No additional details are available for this notification.</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
