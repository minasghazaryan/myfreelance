@page
@using MyFreelance.Domain.Constants
@{ ViewData["Title"] = "Access Denied"; }

<div class="container text-center py-5 mt-5">
    <h1 class="text-gold">Access Denied</h1>
    <p class="text-muted-light">You do not have permission to access this resource.</p>
    @if (User.IsInRole(AppRoles.Admin))
    {
        <a asp-area="Admin" asp-page="/Index" class="btn btn-aurum mt-3">Go to Admin Dashboard</a>
    }
    else if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="/Dashboard/Index" class="btn btn-aurum mt-3">Go to Dashboard</a>
    }
    else
    {
        <a asp-page="/Index" class="btn btn-aurum mt-3">Go Home</a>
    }
</div>
