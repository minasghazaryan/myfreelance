@page
@model MyFreelance.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Premium Blockchain Investing";
}

@if (TempData["ContactSuccess"] as bool? == true)
{
    <div class="container pt-5 mt-4">
        <div class="alert alert-aurum-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>Thank you — our team will respond within one business day.
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<!-- Hero -->
<section class="hero-section hero-section-compact">
    <div class="hero-bg"></div>
    <div class="container hero-content">
        <div class="row align-items-center g-4 g-lg-5">
            <div class="col-lg-6 animate-in">
                <h1 class="hero-title">Institutional-Grade <span class="text-gold">Blockchain Investing</span> for Ghana &amp; Beyond</h1>
                <p class="hero-subtitle">Verified onboarding, transparent tiers, and real-time portfolio visibility.</p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a asp-page="/Account/Register" class="btn btn-aurum btn-lg">Open Investor Account</a>
                    <a href="#tiers" class="btn btn-aurum-outline btn-lg">View Investment Tiers</a>
                </div>
                <p class="hero-disclaimer mt-4 mb-0">
                    <i class="bi bi-info-circle me-1"></i>Projected yields are illustrative. Capital is at risk.
                </p>
            </div>
            <div class="col-lg-6 animate-in">
                <div class="hero-trust-panel aurum-card">
                    <p class="hero-panel-label mb-1">Built for trust</p>
                    <h3 class="hero-panel-title mb-3">Why investors stay with us</h3>
                    <div class="hero-highlight-list">
                        @foreach (var (icon, title, text) in new[] {
                            ("bi-person-check", "Verified onboarding", "KYC and phone verification before your first deposit."),
                            ("bi-speedometer2", "Live dashboard", "Track balances, tiers, and performance in one place."),
                            ("bi-file-earmark-text", "Clear terms", "Published limits, yields, and withdrawal rules upfront.")
                        })
                        {
                            <div class="hero-highlight-item">
                                <div class="hero-highlight-icon"><i class="bi @icon"></i></div>
                                <div>
                                    <strong>@title</strong>
                                    <span>@text</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Trust strip -->
<section class="trust-strip">
    <div class="container">
        <div class="trust-strip-grid">
            @foreach (var (icon, title) in new[] {
                ("bi-person-vcard", "KYC Verified"),
                ("bi-shield-lock", "Encrypted Platform"),
                ("bi-headset", "Live Support")
            })
            {
                <div class="trust-strip-item">
                    <i class="bi @icon"></i>
                    <strong>@title</strong>
                </div>
            }
        </div>
    </div>
</section>

<!-- Investment Tiers -->
<section id="tiers" class="landing-section section-dark">
    <div class="container">
        <div class="landing-section-header text-center">
            <h2 class="section-title text-gold">Investment Tiers</h2>
            <p class="section-subtitle mb-0">Structured products with defined limits — choose the profile that fits your goals</p>
        </div>
        <div class="row g-4 mt-2 justify-content-center">
            @foreach (var tier in Model.Tiers)
            {
                var tierClass = tier.Name.ToLower() switch { "bronze" => "tier-bronze", "silver" => "tier-silver", _ => "tier-gold" };
                var riskClass = tier.RiskLevel switch { "Low" => "risk-low", "Moderate" => "risk-moderate", _ => "risk-high" };
                <div class="col-md-4">
                    <div class="aurum-card @tierClass tier-card h-100 text-start">
                        <div class="d-flex justify-content-between align-items-start">
                            <h4 class="mb-0">@tier.Name</h4>
                            <span class="risk-badge @riskClass">@tier.RiskLevel</span>
                        </div>
                        <div class="tier-yield my-3">@tier.ProjectedYieldPercent.ToString("0.##")%</div>
                        <p class="small text-muted-light mb-0">Projected yield — not guaranteed</p>
                        <p class="mt-3 small text-muted-light">@tier.Description</p>
                        <hr class="border-gold-subtle" />
                        <div class="tier-limits">
                            <div><span>Minimum</span><strong>$@tier.MinInvestment.ToString("N0")</strong></div>
                            <div><span>Maximum</span><strong>$@tier.MaxInvestment.ToString("N0")</strong></div>
                        </div>
                        <a asp-page="/Account/Register" class="btn btn-aurum-outline w-100 mt-3">Start with @tier.Name</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- How It Works -->
<section id="how-it-works" class="landing-section section-black">
    <div class="container">
        <div class="landing-section-header text-center">
            <h2 class="section-title text-gold">How It Works</h2>
            <p class="section-subtitle mb-0">A clear, regulated-style onboarding path — no hidden steps</p>
        </div>
        <div class="steps-timeline row g-3 g-lg-4 mt-2">
            @foreach (var (step, title, desc) in new[] {
                (1, "Register", "Create your secure investor profile"),
                (2, "Verify Identity", "Complete KYC & phone verification"),
                (3, "Select Tier", "Choose risk level & investment size"),
                (4, "Fund Account", "Deposit via supported USDT networks"),
                (5, "Track Growth", "Monitor performance in your dashboard"),
                (6, "Withdraw", "Request payouts with clear terms")
            })
            {
                <div class="col-md-6 col-lg-4">
                    <div class="aurum-card step-card h-100">
                        <div class="step-number">@step</div>
                        <h6 class="mb-2">@title</h6>
                        <p class="small text-muted-light mb-0">@desc</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Why Investors Trust Us -->
<section id="trust" class="landing-section section-dark">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-lg-5">
                <h2 class="section-title">Built for <span class="text-gold">Serious Investors</span></h2>
                <p class="text-muted-light mb-4">We combine blockchain efficiency with the discipline investors expect from traditional finance — transparent tiers, documented processes, and accountable support.</p>
                <ul class="trust-checklist list-unstyled mb-0">
                    <li><i class="bi bi-check2-circle"></i> Tiered products with published min/max limits and risk labels</li>
                    <li><i class="bi bi-check2-circle"></i> Mandatory verification before deposits are accepted</li>
                    <li><i class="bi bi-check2-circle"></i> Withdrawal rules disclosed upfront — no surprise lock-ins</li>
                    <li><i class="bi bi-check2-circle"></i> Legal pages, FAQs, and contact channels always accessible</li>
                </ul>
            </div>
            <div class="col-lg-7">
                <div class="row g-3">
                    @foreach (var (icon, title, desc) in new[] {
                        ("bi-shield-lock", "Smart Contract Layer", "Capital routed through audited allocation logic with on-chain traceability."),
                        ("bi-clipboard-data", "Transparent Reporting", "Dashboard metrics, tier performance, and transaction history in one place."),
                        ("bi-people", "Referral Integrity", "Multi-level commissions with published rates — no opaque bonuses."),
                        ("bi-building-check", "Operational Standards", "AML monitoring, encrypted infrastructure, and documented compliance workflows.")
                    })
                    {
                        <div class="col-sm-6">
                            <div class="aurum-card trust-pillar h-100">
                                <i class="bi @icon trust-pillar-icon"></i>
                                <h6>@title</h6>
                                <p class="small text-muted-light mb-0">@desc</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Investment Engine -->
<section class="landing-section section-black">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <h2 class="section-title">The <span class="text-gold">Allocation Engine</span></h2>
                <p class="text-muted-light mb-4">Our smart-contract engine distributes capital across diversified on-chain strategies with continuous risk scoring and rebalancing.</p>
                <ul class="list-unstyled engine-list mb-0">
                    <li><i class="bi bi-check-circle text-gold me-2"></i>Adaptive allocation across DeFi strategies</li>
                    <li><i class="bi bi-check-circle text-gold me-2"></i>Multi-strategy deployment with risk scoring</li>
                    <li><i class="bi bi-check-circle text-gold me-2"></i>Automated rebalancing for optimal performance</li>
                    <li><i class="bi bi-check-circle text-gold me-2"></i>Smart contract transparency on-chain</li>
                    <li><i class="bi bi-check-circle text-gold me-2"></i>Real-time risk management monitoring</li>
                </ul>
            </div>
            <div class="col-lg-6">
                <div class="aurum-card">
                    <p class="small text-muted-light mb-3">Current strategy mix (illustrative allocation)</p>
                    <canvas id="strategyChart" height="220"></canvas>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials -->
<section class="landing-section section-black">
    <div class="container">
        <div class="landing-section-header text-center">
            <h2 class="section-title text-gold">What Investors Say</h2>
            <p class="section-subtitle mb-0">Real feedback from verified platform members</p>
        </div>
        <div class="row g-4 mt-2">
            @foreach (var testimonial in Model.Testimonials)
            {
                <div class="col-lg-4">
                    <div class="aurum-card testimonial-card h-100">
                        <div class="testimonial-stars">
                            @for (var s = 0; s < 5; s++) { <i class="bi bi-star-fill"></i> }
                        </div>
                        <p class="testimonial-quote">"@testimonial.Content"</p>
                        <div class="testimonial-author">
                            <div class="testimonial-avatar">@testimonial.AuthorName[0]</div>
                            <div>
                                <strong>@testimonial.AuthorName</strong>
                                <span>@testimonial.AuthorSubtitle@(testimonial.Location is not null ? $" · {testimonial.Location}" : "")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Security & Compliance -->
<section id="security" class="landing-section section-dark">
    <div class="container">
        <div class="landing-section-header text-center">
            <h2 class="section-title text-gold">Security &amp; Compliance</h2>
            <p class="section-subtitle mb-0">Multiple layers of protection across identity, infrastructure, and transactions</p>
        </div>
        <div class="row g-3 g-lg-4 mt-2">
            @foreach (var (icon, title, desc) in new[] {
                ("bi-shield-lock", "Smart Contract Technology", "On-chain transparency with audited allocation contracts"),
                ("bi-person-badge", "Identity Verification", "Multi-step KYC with document verification"),
                ("bi-lock", "Encrypted Infrastructure", "End-to-end encryption for sensitive data"),
                ("bi-search", "AML Monitoring", "Continuous anti-money laundering compliance"),
                ("bi-link-45deg", "Blockchain Transparency", "Full transaction traceability on-chain"),
                ("bi-file-text", "Legal Documentation", "Terms, privacy policy, and risk disclosures published")
            })
            {
                <div class="col-md-6 col-lg-4">
                    <div class="aurum-card security-card h-100">
                        <i class="bi @icon security-icon"></i>
                        <h6>@title</h6>
                        <p class="small text-muted-light mb-0">@desc</p>
                    </div>
                </div>
            }
        </div>
        <div class="compliance-banner aurum-card mt-4">
            <div class="row align-items-center g-3">
                <div class="col-lg-8">
                    <h5 class="text-gold mb-2"><i class="bi bi-exclamation-triangle me-2"></i>Investor Responsibility</h5>
                    <p class="small text-muted-light mb-0">AurumWealth does not provide personalized financial advice. Review tier documents, understand withdrawal penalties, and only invest capital you can afford to expose to market risk.</p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a asp-page="/Cms/Page" asp-route-slug="terms" class="btn btn-aurum-outline btn-sm me-2">Terms</a>
                    <a asp-page="/Cms/Page" asp-route-slug="privacy" class="btn btn-aurum-outline btn-sm">Privacy</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Referral Program (compact) -->
<section class="landing-section section-black">
    <div class="container">
        <div class="aurum-card referral-compact">
            <div class="row align-items-center g-4">
                <div class="col-lg-4">
                    <h3 class="section-title text-gold h4 mb-2">Referral Program</h3>
                    <p class="text-muted-light small mb-0">Earn published commissions when your network invests — three transparent levels.</p>
                </div>
                <div class="col-lg-8">
                    <div class="row g-3">
                        @foreach (var level in Model.ReferralLevels)
                        {
                            <div class="col-md-4">
                                <div class="referral-level-card text-center">
                                    <p class="text-muted-light small text-uppercase mb-1">Level @level.Level</p>
                                    <div class="referral-percent">@level.Percentage.ToString("F0")%</div>
                                    <p class="small text-muted-light mb-0">@level.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FAQ -->
<section id="faq" class="landing-section section-dark">
    <div class="container">
        <div class="landing-section-header text-center">
            <h2 class="section-title text-gold">Frequently Asked Questions</h2>
            <p class="section-subtitle mb-0">Straight answers before you commit capital</p>
        </div>
        <div class="accordion accordion-aurum mx-auto landing-faq" id="faqAccordion">
            @for (var i = 0; i < Model.Faqs.Count; i++)
            {
                var faq = Model.Faqs[i];
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button @(i > 0 ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#faq@(i)">
                            @faq.Question
                        </button>
                    </h2>
                    <div id="faq@(i)" class="accordion-collapse collapse @(i == 0 ? "show" : "")" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">@faq.Answer</div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Contact -->
<section id="contact" class="landing-section section-black">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-5">
                <h2 class="section-title text-gold">Talk to Our Team</h2>
                <p class="text-muted-light">Questions about verification, deposits, or tiers? We respond within one business day.</p>
                <div class="contact-channels mt-4">
                    <div class="contact-channel"><i class="bi bi-envelope"></i><div><strong>Email</strong><span>support@aurumwealth.gh</span></div></div>
                    <div class="contact-channel"><i class="bi bi-whatsapp"></i><div><strong>WhatsApp</strong><span>+233 20 123 4567</span></div></div>
                    <div class="contact-channel"><i class="bi bi-telegram"></i><div><strong>Telegram</strong><span>@@AurumWealthGH</span></div></div>
                </div>
                <div class="aurum-card mt-4 p-3">
                    <p class="small text-muted-light mb-0"><i class="bi bi-clock text-gold me-2"></i>Support hours: Mon–Sat, 8:00 AM – 8:00 PM GMT</p>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="aurum-card">
                    <h5 class="mb-4">Send a Message</h5>
                    <form method="post" asp-page-handler="Contact">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Name</label>
                                <input type="text" name="name" class="form-control form-control-aurum" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <input type="email" name="email" class="form-control form-control-aurum" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Subject</label>
                                <input type="text" name="subject" class="form-control form-control-aurum" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Message</label>
                                <textarea name="message" rows="4" class="form-control form-control-aurum" required placeholder="Tell us about your investment goals or question..."></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-aurum">Send Message</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const sc = document.getElementById('strategyChart');
        if (sc && typeof Chart !== 'undefined') {
            new Chart(sc, {
                type: 'doughnut',
                data: {
                    labels: ['DeFi Yield', 'Stablecoin LP', 'Arbitrage', 'Staking'],
                    datasets: [{ data: [35, 25, 20, 20], backgroundColor: ['#d4af37', '#b8960c', '#f4e4a6', '#8b7355'], borderWidth: 0 }]
                },
                options: { plugins: { legend: { position: 'bottom', labels: { color: '#9a9a9a', padding: 16 } } } }
            });
        }
    </script>
}
